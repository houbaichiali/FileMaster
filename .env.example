# Copy to .env (never commit .env). All backend variables use the FILEMASTER_ prefix.
FILEMASTER_MAX_UPLOAD_MB=200
FILEMASTER_FILE_TTL_MINUTES=60
FILEMASTER_FFMPEG_TIMEOUT_S=900
FILEMASTER_MAX_WORKERS=2
FILEMASTER_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# FILEMASTER_WORK_DIR=/var/lib/filemaster   # defaults to the system temp dir
# Frontend dev proxy target
VITE_BACKEND_URL=http://127.0.0.1:8000
